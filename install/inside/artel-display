#!/bin/bash
# Virtual display :1 for agents: TigerVNC (passwordless, listening only on the container's localhost),
# openbox as the window manager, and noVNC on 6080, which the host forwards externally. The user views
# the screen in a browser; agents use DISPLAY=:1 (headed Playwright, xdotool, scrot).
set -euo pipefail
GEOM="${ARTEL_DISPLAY_GEOMETRY:-1280x800}"
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
Xtigervnc :1 -geometry "$GEOM" -depth 24 -SecurityTypes None -localhost yes -rfbport 5901 -AlwaysShared -desktop artel &
XPID=$!
for _ in $(seq 1 100); do [ -S /tmp/.X11-unix/X1 ] && break; sleep 0.1; done
export DISPLAY=:1
xsetroot -solid '#2b3440' || true
openbox &
websockify --web /usr/share/novnc 6080 localhost:5901 &
wait "$XPID"
