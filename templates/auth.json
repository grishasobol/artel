// This is a template. Remove // only from the lines you need and replace the values with real ones.
// apply-auth removes comment lines before parsing the JSON.
{
  "version": 1,
  "notes": "Secrets are stored only for the artel user; do not add this file to git.",

  // Claude subscription: run claude setup-token on any machine, paste the browser code back into
  // the terminal, and the command will print a token like sk-ant-oat01-.... Put that token (not the browser code) in oauth_token.
  // Do not copy the host session (~/.claude/.credentials.json) into the container: it expires when the host refreshes it.
  "claude": {
    "method": "oauth_token",
    "oauth_token": "sk-ant-oat01-REPLACE_ME"
    // API billing alternative: console.anthropic.com -> API Keys.
    // "method": "api_key",
    // "api_key": "sk-ant-api03-REPLACE_ME"
  },

  // Codex API: get the key from platform.openai.com/api-keys.
  "codex": {
    "method": "api_key",
    "api_key": "sk-proj-REPLACE_ME"
    // ChatGPT subscription alternative.
    // Run codex login on any machine, then copy the contents of ~/.codex/auth.json
    // into auth_json. For several containers, api_key is more reliable.
    // "method": "chatgpt",
    // "auth_json": { "example": "paste the contents of ~/.codex/auth.json" }
  },

  // Official agy path: create a Gemini key at https://aistudio.google.com/apikey.
  "agy": {
    "method": "gemini_api_key",
    "gemini_api_key": "AIza-REPLACE_ME"
    // Google AI subscription alternative.
    // On a Linux host, get the token with:
    // secret-tool lookup service gemini username antigravity
    // Then put it in token without changing keyring_attrs.
    // "method": "keyring_token",
    // "keyring_attrs": { "service": "gemini", "username": "antigravity" },
    // "token": "REPLACE_ME"
    // "base_url": "https://generativelanguage.googleapis.com"
  },

  // opencode provider variables go into auth.env and environment.d.
  "opencode": {
    "model": "openrouter/REPLACE_ME-model",
    "providers": {
      "openrouter": {
        "env": { "OPENROUTER_API_KEY": "sk-or-v1-REPLACE_ME" }
      },
      "anthropic": {
        "env": { "ANTHROPIC_API_KEY": "sk-ant-api03-REPLACE_ME" }
      }
      // Example service account for google-vertex.
      // Paths must be under /home/artel.
      // "google-vertex": {
      //   "env": {
      //     "GOOGLE_CLOUD_PROJECT": "REPLACE_ME-project",
      //     "GOOGLE_APPLICATION_CREDENTIALS": "/home/artel/.secrets/vertex-sa.json"
      //   },
      //   "files": {
      //     "/home/artel/.secrets/vertex-sa.json": {
      //       "type": "service_account",
      //       "project_id": "REPLACE_ME-project",
      //       "private_key": "REPLACE_ME"
      //     }
      //   }
      // }
    }
  }
}
